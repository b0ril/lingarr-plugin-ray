<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Lingarr.Plugin.Ray</AssemblyName>
    <RootNamespace>Lingarr.Plugin.Ray</RootNamespace>
    <Description>Lingarr community plugin for Ray Headless / Sunlight batch subtitle translation.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <Reference Include="Lingarr.Contracts">
      <HintPath>$(LingarrContractsPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
